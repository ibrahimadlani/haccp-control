DATABASE_URL=postgresql+asyncpg://haccp_user:haccp_password@db:5432/haccp_control
# Local/dev example only. Use strong random values via secret manager in staging/prod.
JWT_SECRET_KEY=change-me-in-production-local-secret
JWT_ALGORITHM=HS256
ESTABLISHMENT_ACCESS_TOKEN_EXPIRE_HOURS=12
ENVIRONMENT=local
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
METRICS_ENABLED=true
METRICS_ENDPOINT=/metrics
# Required in production — must be at least 32 chars. Restricts POST /organisations to platform admins only.
PLATFORM_ADMIN_KEY=change-me-in-production-platform-secret-32chars
# Optional. If set, /metrics requires "Authorization: Bearer <token>". Leave empty to keep metrics open (local dev only).
METRICS_TOKEN=

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=eu-west-3
AWS_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=haccp-documents

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
